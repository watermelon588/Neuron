# Copy to `.env` on the VM and fill in. Never commit the real .env.
# Generate SECRET_KEY with:  openssl rand -hex 32

ENVIRONMENT=production
SECRET_KEY=

# Cross-site cookies for the Vercel frontend. Both are mandatory in this setup:
# the browser discards a SameSite=None cookie that isn't also Secure, and
# Secure works because Tailscale Funnel serves real HTTPS.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Tailscale Funnel sits in front of the app.
TRUSTED_PROXY_HOPS=1

# The 24 GB VM can run the local LLM, but Groq is far faster. Leave false and
# set GROQ_API_KEY; flip to true only if you have no Groq key.
ENABLE_LOCAL_LLM=false

# ── Secrets ──────────────────────────────────────────────────────
MONGODB_URI=
SERPER_API_KEY=
GROQ_API_KEY=

# Your Vercel frontend origin, no trailing slash, e.g. https://neuron.vercel.app
CORS_ORIGINS=
